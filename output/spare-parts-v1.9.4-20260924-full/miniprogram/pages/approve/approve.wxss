.container {
  padding: 20rpx 15rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 加载/空数据样式 */
.loading, .empty-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

/* 滚动列表样式（修复滚动失效，适配所有屏幕） */
.list-scroll {
  height: calc(100vh - 40rpx);
  box-sizing: border-box;
  overflow-y: auto;
  scrollbar-width: none; /* 隐藏滚动条（移动端） */
  padding-bottom: 20rpx; /* 新增：避免底部内容被遮挡 */
}
.list-scroll::-webkit-scrollbar {
  display: none; /* 隐藏滚动条（iOS/Android） */
}

/* 审批卡片样式 */
.approve-item {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  padding: 30rpx;
  margin-bottom: 25rpx;
}

/* 标题栏 */
.item-header {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-bottom: 15rpx;
}
.order-info {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}
.order-info .label {
  font-weight: 600;
  color:#1890ff;
}
.order-info .value {
  color: #666;
  word-break: break-all; /* 超长单号换行 */
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 15rpx 0;
}

/* 基础信息样式 */
.filter-info, .base-info {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx 25rpx;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
  justify-content: center;
}
.info-item {
  padding: 5rpx 15rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  word-break: break-all; /* 超长内容换行 */
}

/* 异常备件模块 */
.abnormal-wrap {
  margin-bottom: 25rpx;
}
.abnormal-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1890ff;
  text-align: center;
  margin-bottom: 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #e6f7ff;
}

/* 无异常备件提示 */
.no-abnormal-tip {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #e6f7ff;
}

/* 表格样式（调整列宽占比+适配） */
.abnormal-table {
  border: 1rpx solid #e6f7ff;
  border-radius: 12rpx;
  overflow: hidden;
}
.table-header {
  display: flex;
  background-color: #e6f7ff;
  padding: 15rpx 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1890ff;
}
/* 列宽占比：备件名称加宽，其他列适配 */
.col-name {
  flex: 2.5; /* 加宽备件名称列 */
  text-align: center;
}
.col-code {
  flex: 1.5;
  text-align: center;
}
.col-stock, .col-actual {
  flex: 1;
  text-align: center;
}

.table-row {
  display: flex;
  padding: 15rpx 10rpx;
  border-top: 1rpx solid #e6f7ff;
  font-size: 22rpx;
  align-items: center;
}
.table-row .col-name {
  text-align: center;
  padding-left: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis; /* 超长名称显示省略号 */
}
.table-row .col-code, .table-row .col-stock, .table-row .col-actual {
  text-align: center;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 操作按钮区域 */
.operate-wrap {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}
/* 驳回按钮 */
.reject-btn {
  flex: 1;
  height: 80rpx;
  line-height: 45rpx; /* 优化：与高度一致，完美垂直居中 */
  background-color: #fff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  background-image: none; /* 去除微信默认按钮背景 */
}
/* 通过按钮 */
.pass-btn {
  flex: 1;
  height: 80rpx;
  line-height: 45rpx; /* 优化：与高度一致，完美垂直居中 */
  background-color: #1890ff;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  background-image: none; /* 去除微信默认按钮背景 */
}
/* 按钮点击反馈 */
.reject-btn:active {
  background-color: #fff5f5;
}
.pass-btn:active {
  background-color: #096dd9;
}
/* 按钮禁用样式（兜底） */
.reject-btn[disabled], .pass-btn[disabled] {
  opacity: 0.6;
  cursor: not-allowed;
}

/* 无权限提示 */
.no-permission {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
  margin-top: 10rpx;
}