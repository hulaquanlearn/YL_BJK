<view class="detail-page">
  <view class="card">
    <view class="card-header">基本信息</view>
    <view class="card-item">
      <text class="label">物料编码：</text>
      <text class="value">{{part.materialCode}}</text>
    </view>
    <view class="card-item">
      <text class="label">物料描述：</text>
      <text class="value">{{part.materialDesc}}</text>
    </view>
    <view class="card-item">
      <text class="label">位置信息：</text>
      <text class="value">{{part.locationDisplay}}</text>
    </view>
    <view class="card-item" wx:if="{{part.locationCode}}">
      <text class="label">货位编码：</text>
      <text class="value">{{part.locationCode}}</text>
    </view>
    <view class="card-item">
      <text class="label">备件类型：</text>
      <text class="value">{{part.partType || '未填写'}}</text>
    </view>
    <view class="card-item">
      <text class="label">用途：</text>
      <text class="value">{{part.usageDescription || '未填写'}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-header">库存状态</view>
    <view class="stock-row">
      <view class="stock-number">
        <text class="number">{{part.totalStock}}</text>
        <text class="unit">{{part.unit}}</text>
      </view>
    </view>
    <view class="stock-info">
      <text class="stock-update">最后更新：{{part.updateTime || '暂无记录'}}</text>
    </view>
    <view class="card-item">
      <text class="label">订购点：</text>
      <text class="value">{{part.reorderPointText}}</text>
    </view>
    <view class="card-item">
      <text class="label">最高储备：</text>
      <text class="value">{{part.maxStockText}}</text>
    </view>
    <view class="card-item">
      <text class="label">未税单价：</text>
      <text class="value">{{part.priceText}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{canEditPart || isViewer}}">
    <view class="card-header">库存调整</view>
    <view class="operation-reason">
      <text class="operation-label">操作原因：</text>
      <input class="reason-input" placeholder="如：设备检修领用、台账调整" maxlength="200" value="{{stockReason}}" bindinput="bindStockReason" />
    </view>
    <view class="operation-item">
      <text class="operation-label">入库数量：</text>
      <input 
        type="digit" 
        placeholder="输入入库数量" 
        value="{{stockIn}}"
        bindinput="bindStockIn"
        class="operation-input"
        placeholder-style="color: #999;"
      />
      <button 
        bindtap="confirmStockIn" 
        class="btn stock-in" 
        disabled="{{isStockOperating}}"
      >
        确认入库
      </button>
    </view>
    <view class="operation-item">
      <text class="operation-label">出库数量：</text>
      <input 
        type="digit" 
        placeholder="输入出库数量" 
        value="{{stockOut}}"
        bindinput="bindStockOut"
        class="operation-input"
        placeholder-style="color: #999;"
      />
      <button 
        bindtap="confirmStockOut" 
        class="btn stock-out" 
        disabled="{{isStockOperating}}"
      >
        确认出库
      </button>
    </view>
  </view>

  <view class="card permission-note" wx:else>
    <view class="card-header">权限说明</view>
    <view class="remark-content">普通用户可查看库存信息，出入库操作仅限管理员。</view>
  </view>

  <view class="card">
    <view class="card-header">备注信息</view>
    <view class="remark-content">{{part.remark}}</view>
  </view>

  <button class="archive-btn" wx:if="{{canEditPart || isViewer}}" bindtap="archivePart">停用该备件记录</button>
</view>
