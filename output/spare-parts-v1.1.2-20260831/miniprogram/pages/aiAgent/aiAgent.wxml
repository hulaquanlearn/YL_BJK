<view class="assistant-page">
  <view class="assistant-hero">
    <view class="hero-top">
      <view>
        <text class="hero-title">备件与设备助手</text>
        <text class="hero-desc">自动识别问题类型，库存查询不等待大模型</text>
      </view>
      <text class="smart-badge">智能分流</text>
    </view>
    <view class="scope-row">
      <text>实时库存</text>
      <text>库位定位</text>
      <text>维修保养</text>
    </view>
  </view>

  <view class="input-card">
    <textarea
      class="input-box"
      maxlength="500"
      placeholder="输入物料编码、备件名称、库位，或描述设备故障现象"
      value="{{userQuestion}}"
      bindinput="handleInput"
    ></textarea>
    <view class="input-footer">
      <text class="scope-tip">系统会自动判断库存、维修或范围外问题</text>
      <text class="clear-history" wx:if="{{resultType || messages.length}}" bindtap="clearChatHistory">清空</text>
    </view>
  </view>

  <view class="suggestions">
    <text class="suggestion-title">库存查询示例</text>
    <scroll-view class="suggestion-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="suggestion-row">
        <view
          class="suggestion-chip"
          wx:for="{{inventorySuggestions}}"
          wx:key="*this"
          bindtap="useSuggestion"
          data-text="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
    <text class="suggestion-title maintenance-title">维修咨询示例</text>
    <scroll-view class="suggestion-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="suggestion-row">
        <view
          class="suggestion-chip maintenance"
          wx:for="{{maintenanceSuggestions}}"
          wx:key="*this"
          bindtap="useSuggestion"
          data-text="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <button class="query-btn" bindtap="callAi" loading="{{isLoading}}" disabled="{{isLoading}}">
    {{isLoading ? '正在识别并查询...' : '智能查询'}}
  </button>

  <view class="result-card" wx:if="{{resultType}}">
    <view class="result-heading">
      <text class="result-title">{{resultTitle}}</text>
      <text class="source-badge">{{resultBadge}}</text>
    </view>

    <view class="summary-box" wx:if="{{resultSummary}}">
      <view><text class="summary-value">{{resultSummary.value}}</text><text class="summary-label">{{resultSummary.label}}</text></view>
      <text class="summary-detail">{{resultSummary.detail}}</text>
    </view>

    <text class="result-content" wx:if="{{resultText}}">{{resultText}}</text>

    <view class="clarification-list" wx:if="{{clarificationOptions.length}}">
      <button
        class="clarification-btn"
        wx:for="{{clarificationOptions}}"
        wx:key="area"
        data-area="{{item.area}}"
        bindtap="chooseClarification"
      >查询 {{item.label}}</button>
    </view>

    <view class="inventory-result-list" wx:if="{{resultCards.length}}">
      <view
        class="inventory-result-card"
        wx:for="{{resultCards}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="goToDetail"
        hover-class="inventory-card-hover"
      >
        <view class="inventory-card-head">
          <view class="inventory-card-title">
            <text class="inventory-name">{{item.materialDesc || '未命名备件'}}</text>
            <text class="inventory-code">{{item.materialCode || '-'}}</text>
          </view>
          <view class="inventory-stock {{item.stockStatus}}">
            <text class="inventory-stock-state">{{item.stockStatusText}}</text>
            <text class="inventory-stock-value">{{item.totalStock || 0}}{{item.unit || ''}}</text>
          </view>
        </view>
        <view class="inventory-spec">
          <text class="inventory-meta-label">规格型号</text>
          <text class="inventory-meta-value">{{item.specDisplay}}</text>
        </view>
        <view class="inventory-location">
          <text class="inventory-meta-label">存放位置</text>
          <text class="inventory-meta-value">{{item.locationDisplay}}</text>
        </view>
        <text class="card-action">查看备件详情</text>
      </view>
    </view>

    <text class="safety-note" wx:if="{{resultType === 'maintenance'}}">
      涉及停机、带电、高处或受限空间作业时，请以现场安全规程和专业人员判断为准。
    </text>
  </view>
</view>
