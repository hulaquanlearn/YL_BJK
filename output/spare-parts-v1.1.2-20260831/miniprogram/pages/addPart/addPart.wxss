.container {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(170rpx + env(safe-area-inset-bottom));
  background: #f4f6f8;
}

.stepper { display: flex; margin-bottom: 20rpx; padding: 24rpx 18rpx; align-items: center; border-radius: 20rpx; background: #fff; }
.step { display: flex; flex: none; align-items: center; flex-direction: column; gap: 7rpx; color: #8a929e; font-size: 22rpx; }
.step-no { width: 44rpx; height: 44rpx; border-radius: 50%; color: #6f7885; background: #edf0f3; font-size: 23rpx; font-weight: 700; line-height: 44rpx; text-align: center; }
.step.active { color: #8f1119; }
.step.active .step-no { color: #fff; background: #c6000b; }
.step-line { height: 2rpx; flex: 1; margin: -28rpx 10rpx 0; background: #e3e7ec; }
.step-line.active { background: #c6000b; }
.field-hint { display: block; margin-top: 10rpx; color: #9b5b13; font-size: 23rpx; line-height: 1.5; }
.review-card { margin: 10rpx 0 24rpx; padding: 22rpx; border-radius: 16rpx; background: #f7f8fa; }
.review-card text { display: block; margin: 7rpx 0; color: #4e5865; font-size: 25rpx; }

.form-card {
  margin-bottom: 28rpx;
}

.form-group {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(31, 41, 55, 0.06);
}

.form-group:last-child {
  margin-bottom: 0;
}

.group-title {
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.group-desc {
  margin: 6rpx 0 24rpx;
  color: #98a2b3;
  font-size: 23rpx;
  line-height: 34rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item {
  width: 100%;
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-item-half {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #344054;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.required-mark {
  color: #f04438;
}

.input,
.picker-text,
.textarea {
  width: 100%;
  color: #1f2937;
  font-size: 27rpx;
  border: 2rpx solid #e4e7ec;
  background: #f9fafb;
  box-sizing: border-box;
}

.input {
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
}

.input.required {
  border-left: 2rpx solid #e4e7ec;
}

.input:focus,
.textarea:focus {
  border-color: #c6000b;
  background: #fff;
}

.picker-wrap {
  display: flex;
  width: 100%;
  height: 80rpx;
}

.picker {
  flex: 1;
  min-width: 0;
}

.picker-text {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 22rpx;
  color: #667085;
  border-right: none;
  border-radius: 12rpx 0 0 12rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 84rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  color: #fff;
  font-size: 38rpx;
  line-height: 80rpx;
  background: #c6000b;
  border-radius: 0 12rpx 12rpx 0;
}

.add-btn.disabled {
  color: #98a2b3;
  background: #e4e7ec;
}

.textarea {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  line-height: 40rpx;
}

.location-tip {
  margin-top: -6rpx;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 34rpx;
}

.submit-btn-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -6rpx 20rpx rgba(31, 41, 55, 0.08);
  display: flex;
}

.step-back-btn { height: 88rpx; flex: 0 0 180rpx; margin: 0 14rpx 0 0; border: 1rpx solid #d8dde4; border-radius: 14rpx; color: #5f6875; background: #fff; font-size: 28rpx; line-height: 88rpx; }

.submit-btn {
  width: auto;
  flex: 1;
  height: 88rpx;
  margin: 0;
  padding: 0;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  background: #c6000b;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 18rpx rgba(198, 0, 11, 0.2);
}

.submit-btn.loading {
  background: #d27a80;
  box-shadow: none;
}

.submit-btn.btn-disabled {
  color: #fff;
  background: #b7c0ce;
  box-shadow: none;
}

.loading-icon {
  margin-right: 10rpx;
  font-size: 22rpx;
  animation: loading 1s infinite;
}

@keyframes loading {
  0% { opacity: 0.3; }
  50% { opacity: 1; }
  100% { opacity: 0.3; }
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  background: rgba(16, 24, 40, 0.55);
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 1000;
  width: 640rpx;
  max-width: calc(100vw - 64rpx);
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
  transform: translate(-50%, -50%);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #eaecf0;
}

.modal-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 700;
}

.modal-close {
  padding: 0 8rpx;
  color: #98a2b3;
  font-size: 40rpx;
}

.modal-body {
  padding: 34rpx 30rpx;
}

.modal-input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  font-size: 27rpx;
  border: 2rpx solid #e4e7ec;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.modal-tip {
  display: block;
  margin-top: 16rpx;
  color: #98a2b3;
  font-size: 23rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eaecf0;
}

.modal-btn {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
}

.modal-btn.cancel {
  color: #667085;
  border-right: 1rpx solid #eaecf0;
}

.modal-btn.confirm {
  color: #c6000b;
  font-weight: 700;
}
