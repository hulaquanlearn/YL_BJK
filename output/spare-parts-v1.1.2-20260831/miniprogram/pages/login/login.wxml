<view class="login-page">
  <view class="brand-block">
    <view class="brand-icon">仓</view>
    <text class="brand-title">原粮车间备件管理</text>
    <text class="brand-subtitle">使用分配的账号登录系统</text>
  </view>

  <view class="login-card">
    <view class="field-group">
      <text class="field-label">用户名</text>
      <input class="field-input" value="{{username}}" placeholder="请输入用户名" maxlength="32" bindinput="onUsernameInput" confirm-type="next" />
    </view>
    <view class="field-group">
      <text class="field-label">密码</text>
      <view class="password-row">
        <input class="field-input password-input" value="{{password}}" password="{{!showPassword}}" placeholder="请输入密码" maxlength="72" bindinput="onPasswordInput" confirm-type="done" bindconfirm="submitLogin" />
        <text class="password-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
      </view>
    </view>
    <button class="login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="submitLogin">登录</button>
    <text class="form-error" wx:if="{{formError}}">{{formError}}</text>
    <text class="security-tip">账号由管理员创建。如忘记密码，请联系管理员重置。</text>
  </view>
</view>
