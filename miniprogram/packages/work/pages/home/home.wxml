<view class="duty-home">
 <picker class="week-picker" mode="date" value="{{week}}" disabled="{{loading}}" bindchange="onWeek"><view class="week-bar"><view><text class="week-caption">本周 · 点击切换周次</text><text class="week-range">{{week}} — {{end}}</text></view><text class="week-chevron">⌄</text></view></picker>
 <view wx:if="{{context.isReviewer}}" class="metrics"><view><text class="number">{{counts.total}}</text><text>本周人员</text></view><view><text class="number amber">{{counts.pending}}</text><text>待提交</text></view><view><text class="number green">{{counts.submitted}}</text><text>已提交</text></view><view><text class="number red">{{counts.returned}}</text><text>需补充</text></view></view>

 <view wx:if="{{context.isReviewer}}" class="search-wrap"><input class="search" value="{{search}}" placeholder="搜索姓名、岗位或班组" placeholder-class="search-placeholder" bindinput="onSearch" confirm-type="search" /></view>
 <view class="list-heading"><text>{{context.isReviewer ? '人员填报情况' : '我的周材料'}}</text></view>
 <view wx:if="{{error}}" class="error" bindtap="load">{{error}}　点击重试</view><view wx:if="{{loading}}" class="empty">正在加载…</view>
 <view wx:for="{{visibleRows}}" wx:key="userId" class="person-card"><view class="person-top"><text class="name">{{item.name}}</text><text class="status {{item.status}}">{{item.statusLabel}}</text></view><text class="identity">{{item.position}} · {{item.team || '未分班组'}}</text><view class="progress-line"><progress percent="{{item.total ? item.filled/item.total*100 : 0}}" activeColor="#6263a8" stroke-width="4" /><text>{{item.filled}} / {{item.total || '—'}} 项</text></view><view class="daily-overview"><button wx:for="{{item.dailyOverview}}" wx:for-item="day" wx:key="date" data-user="{{item.userId}}" data-date="{{day.date}}" bindtap="openReport"><text>{{day.shortDate}}</text><text>{{day.shortLabel}}</text></button></view><view class="period-actions"><button size="mini" data-user="{{item.userId}}" data-frequency="每周" bindtap="openReport">每周完成 {{item.weekly.done}}/{{item.weekly.total}}</button><button size="mini" data-user="{{item.userId}}" data-frequency="每月" bindtap="openReport">每月完成 {{item.monthly.done}}/{{item.monthly.total}}</button></view><view wx:if="{{item.progress}}" class="duty-overview"><text class="done">已完成 {{item.progress.done}}</text><text class="{{item.notPerformed ? 'bad' : ''}}">未履职 {{item.cadenceVersion === 2 ? item.notPerformed : item.progress.incomplete}}</text><text>待补材料 {{item.progress.evidence}}</text></view><view class="card-footer"><text class="muted">负责人：{{item.reviewerName || '待分配'}}</text><button wx:if="{{item.canRead || item.editable}}" size="mini" class="card-primary" data-user="{{item.userId}}" bindtap="openReport">{{item.editable ? (item.status === 'empty' ? '开始填写' : item.status === 'returned' ? '补充材料' : '继续填写') : '查看'}}</button><button wx:if="{{item.reportId && (item.status === 'submitted' || item.status === 'confirmed')}}" size="mini" data-id="{{item.reportId}}" bindtap="exportOne">导出</button></view></view>
 <view wx:if="{{!loading && !error && !visibleRows.length}}" class="empty">暂无履职人员，请联系系统管理员在网页分配人员、模板与负责人。</view>

</view>
