.duty-home{padding:26rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));min-height:100vh;background:#f4f6f9;color:#26354a}.week-picker{display:block}.week-bar{display:flex;align-items:center;justify-content:space-between;padding:24rpx 26rpx;background:white;border:1rpx solid #e3e8ef;border-radius:18rpx}.week-caption{display:block;font-size:22rpx;color:#8994a5;line-height:1.5;margin-bottom:6rpx}.week-range{display:block;font-size:27rpx;font-weight:600;line-height:1.6;white-space:nowrap}.week-chevron{color:#8b96a8;font-size:30rpx;margin-left:12rpx}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx;margin:22rpx 0}.metrics>view{background:white;border:1rpx solid #e4e8ef;border-radius:16rpx;padding:18rpx 6rpx;text-align:center;font-size:22rpx;color:#7d899c}.metrics text{display:block;line-height:1.5;white-space:nowrap}.number{font-size:36rpx;font-weight:700;color:#6263a8;margin-bottom:6rpx}.number.amber{color:#bd7b2a}.number.green{color:#16867e}.number.red{color:#c53d4f}.search-wrap{height:88rpx;background:white;border:1rpx solid #e2e7ef;border-radius:16rpx;overflow:hidden;margin:22rpx 0}.search{display:block;width:100%;height:88rpx;min-height:88rpx;padding:0 24rpx;line-height:normal;font-size:27rpx;color:#33445d;box-sizing:border-box}.search-placeholder{color:#9ca6b5;font-size:26rpx}.list-heading{display:flex;align-items:center;justify-content:space-between;margin:26rpx 0 18rpx;font-size:28rpx;font-weight:600}.person-card{background:white;border:1rpx solid #e2e7ef;border-radius:22rpx;padding:26rpx;margin-bottom:20rpx;box-shadow:0 6rpx 24rpx #26354a04}.person-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.name{font-size:31rpx;font-weight:600;line-height:1.5}.status{font-size:21rpx;padding:6rpx 14rpx;border-radius:8rpx;background:#f0f2f6;color:#7d899b;white-space:nowrap;flex-shrink:0}.status.draft{background:#fff6e9;color:#bc7a26}.status.submitted{background:#eeeefa;color:#6263a8}.status.confirmed{background:#eaf6f1;color:#16867e}.status.returned{background:#fff0f1;color:#c53d4f}.identity{display:block;font-size:24rpx;color:#8490a2;margin:12rpx 0 22rpx;line-height:1.6}.progress-line{display:flex;align-items:center;gap:16rpx;font-size:22rpx;color:#8490a2}.progress-line progress{flex:1;min-width:0}.progress-line>text{white-space:nowrap}.daily-overview{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6rpx;margin-top:22rpx}.daily-overview button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;min-width:0;min-height:88rpx;margin:0;padding:10rpx 0;background:#f4f6fa;border:1rpx solid #e9edf4;border-radius:10rpx;color:#77869b;font-size:19rpx;line-height:1.5;white-space:nowrap}.daily-overview button::after{border:0}.daily-overview text{display:block;white-space:nowrap}.period-actions{display:flex;gap:14rpx;margin-top:18rpx}.period-actions button{display:flex;align-items:center;justify-content:center;flex:1;min-height:66rpx;margin:0;padding:10rpx 16rpx;font-size:23rpx;line-height:1.3;border-radius:12rpx;color:#6263a8;background:#f3f3fb}.duty-overview{display:flex;gap:14rpx;flex-wrap:wrap;font-size:23rpx;line-height:1.6;margin:20rpx 0;color:#8490a2}.duty-overview text{background:#f6f8fb;border-radius:8rpx;padding:6rpx 12rpx}.duty-overview .done{color:#16867e;background:#eff8f4}.duty-overview .bad{color:#c53d4f;background:#fff0f1}.card-footer{display:flex;align-items:center;gap:14rpx;padding-top:20rpx;border-top:1rpx solid #eef1f6}.card-footer>.muted{flex:1;min-width:0;font-size:23rpx;line-height:1.6;color:#8b96a7}.card-footer button{display:flex;align-items:center;justify-content:center;flex-shrink:0;min-height:76rpx;margin:0;padding:0 26rpx;background:#f2f3fa;color:#6263a8;font-size:26rpx;line-height:1.2;border-radius:14rpx}.card-footer .card-primary{background:#6263a8;color:white}.empty,.error{padding:64rpx 24rpx;text-align:center;line-height:1.8;font-size:26rpx;color:#8995a7}.error{color:#c53d4f}
