<view class="detail-page">
 <view wx:if="{{error}}" class="error" bindtap="load">{{error}}　点击重试</view><view wx:if="{{loading}}" class="empty">加载中…</view>
 <block wx:if="{{record}}">
  <view class="report-heading"><view class="report-title"><text>{{record.identity.name}}</text><text class="status">{{statusLabel}}</text></view><text class="subtitle">{{record.week_start}} 至 {{weekEnd}}</text><view class="report-progress"><progress percent="{{items.length ? reportStats.progress.total ? reportStats.progress.ready/reportStats.progress.total*100 : 0 : 0}}" activeColor="#6263a8" stroke-width="4" /><text>材料齐备 {{reportStats.progress.ready}}/{{reportStats.progress.total}} 项</text></view><block wx:if="{{cadenceMode}}"><view class="day-choice"><text>{{selectedDate}} · {{dayState === 'work' ? '上班' : dayState === 'rest' ? '休息' : '待确认'}}</text><view wx:if="{{editable}}"><button class="{{dayState === 'work' ? 'active' : ''}}" data-state="work" bindtap="selectDayState">上班</button><button class="{{dayState === 'rest' ? 'active' : ''}}" data-state="rest" bindtap="selectDayState">休息</button></view></view></block><view wx:else class="legacy-mode"><text>历史周汇总，无法推断每天执行情况</text><button wx:if="{{editable}}" bindtap="upgradeCadence">改为按日填报</button></view><view wx:if="{{!cadenceMode && showItems}}" class="progress-filters"><button wx:for="{{progressFilters}}" wx:key="key" class="{{reportFilter === item.key ? 'active' : ''}} {{item.key}}" data-key="{{item.key}}" bindtap="filterDuties">{{item.label}} {{item.count}}</button></view><text wx:if="{{editable}}" class="submission-note">{{reportStats.calendarPending ? '请先确认本周每天上班或休息' : reportStats.progress.ready === reportStats.progress.total ? '材料已齐备，请提交本周材料' : '补齐待填事项和验证材料后提交'}}</text></view>
  <text class="matrix-tip">左右滑动周表，点日期格查看或填写</text><view wx:if="{{record.feedback}}" class="feedback-note">负责人：{{record.feedback}}</view>
  <view wx:if="{{cadenceMode && frequency === '每班' && !showItems}}" class="day-note">{{dayState === 'rest' ? '当日休息，不计入应填履职事项' : editable ? '请先确认当日上班或休息' : '填报人尚未确认当日上班情况'}}</view><scroll-view scroll-x class="week-matrix"><view class="matrix-grid"><view class="matrix-row matrix-header"><view class="matrix-title">工作事项</view><view wx:for="{{matrix.days}}" wx:key="date" class="matrix-day"><text>{{item.name}}</text><text>{{item.shortDate}}</text></view></view><view wx:for="{{matrix.rows}}" wx:for-item="row" wx:key="id" class="matrix-row"><view class="matrix-title"><text class="muted">{{row.frequency === '每班' ? '每日' : row.frequency}} · {{row.category}}</text><text>{{row.title}}</text><text wx:if="{{row.legacySummary}}" class="muted">{{row.legacySummary}}</text><text class="muted">{{row.evidence}}</text></view><button wx:for="{{row.cells}}" wx:for-item="cell" wx:key="date" class="matrix-cell {{cell.tone}}" style="flex-grow:{{cell.span}};flex-basis:{{cell.span * 150}}rpx" data-id="{{row.id}}" data-date="{{cell.date}}" data-frequency="{{row.frequency}}" bindtap="chooseCell"><text>{{cell.text}}</text><text wx:if="{{cell.detail}}" class="cell-detail">{{cell.detail}}</text></button></view></view></scroll-view><view wx:if="{{showItems && !cadenceMode}}" class="table-heading"><text>职责事项</text><text>填写 / 结果</text></view>
  <view wx:if="{{expandedId}}" class="item-editor-mask"><view class="item-editor-sheet"><scroll-view scroll-y class="item-editor-scroll"><block wx:for="{{items}}" wx:key="dutyId"><view wx:if="{{item.visible && expandedId === item.dutyId}}" id="duty-{{item.dutyId}}" class="duty-item {{expandedId === item.dutyId ? 'expanded' : ''}}">
   <view class="item-summary" bindtap="closeItem"><view class="summary-main"><text class="item-meta">{{index+1}} · {{item.category}} · {{item.frequency}}</text><text class="duty-title">{{item.title}}</text></view><view class="summary-status"><text class="fill-state {{item.result ? 'filled' : 'missing'}}">{{item.result ? '已填' : '未填'}}</text><text class="result-badge {{item.resultTone}}">{{item.result || '待填写'}}</text><text wx:if="{{cadenceMode && item.frequency !== '每班'}}" class="execution-date">{{item.recordDate || '未记执行日期'}}</text><text wx:if="{{item.needsEvidence}}" class="result-badge incomplete">待补材料</text></view><text class="row-open">{{expandedId === item.dutyId ? '收起' : editable ? '填写' : '查看'}} ›</text></view>
   <view wx:if="{{expandedId === item.dutyId}}" class="item-body">
    <text wx:if="{{item.evidence}}" class="evidence">{{item.evidence}}</text>
    <text class="label">{{cadenceMode && item.frequency === '每班' ? '当日结果' : cadenceMode && item.frequency === '每月' ? '本月结果' : '本周结果'}}</text><picker range="{{resultOptions}}" value="{{item.resultIndex}}" disabled="{{!item.canEdit || busy}}" data-index="{{index}}" bindchange="onResult"><view class="picker-field">{{cadenceMode && item.frequency === '每班' && item.result === '未完成' ? '未履职' : item.result || '选择结果'}}　⌄</view></picker>
    <text wx:if="{{item.shared}}" class="feedback-note">本月已于 {{item.recordDate}} 完成，材料来自 {{item.originWeek}} 周</text><text wx:if="{{item.recordedAt}}" class="execution-date">记录时间：{{item.recordedAt}}</text><text class="label">{{item.result === '异常' ? '异常原因（必填）' : '履职说明（选填）'}}</text><textarea value="{{item.note}}" placeholder="{{item.result === '异常' ? '请说明发现的问题、异常原因或影响' : '可补充实际完成情况'}}" maxlength="4000" disabled="{{!item.canEdit || busy}}" data-index="{{index}}" data-field="note" bindinput="onField" auto-height adjust-position cursor-spacing="110" />
    <view class="item-photos"><block wx:for="{{photos}}" wx:for-item="photo" wx:key="id"><image wx:if="{{item.selectedPhotos[photo.id]}}" src="{{photo.src}}" mode="aspectFill" data-src="{{photo.src}}" bindtap="previewPhoto" /></block><button wx:if="{{item.canEdit}}" disabled="{{busy}}" data-duty="{{item.dutyId}}" bindtap="uploadPhoto">＋ 添加照片</button></view>
    <view wx:if="{{photos.length}}" class="extra-toggle" data-index="{{index}}" data-field="photoPickerOpen" bindtap="toggleExtra">{{item.photoPickerOpen ? '收起图片选择' : '引用本周其他图片'}}　⌄</view>
    <checkbox-group wx:if="{{item.photoPickerOpen}}" class="check-group" data-index="{{index}}" bindchange="onPhotos"><label wx:for="{{item.photoOptions}}" wx:for-item="photo" wx:key="id"><checkbox value="{{photo.value}}" checked="{{photo.checked}}" disabled="{{!item.canEdit || busy}}" color="#6263a8" />图片 {{photo.id}}</label></checkbox-group>
    <block wx:if="{{cadenceMode && item.frequency !== '每班'}}"><text class="label">实际执行日期（必填）</text><picker mode="date" value="{{item.recordDate}}" start="{{item.executionStart}}" end="{{item.executionEnd}}" disabled="{{!item.canEdit || busy}}" data-index="{{index}}" data-field="recordDate" bindchange="onField"><view class="picker-field">{{item.recordDate || '选择执行日期'}}　⌄</view></picker><text wx:if="{{item.originWeek}}" class="execution-date">沿用 {{item.originWeek}} 周月度记录</text></block><view class="extra-toggle" data-index="{{index}}" data-field="extraOpen" bindtap="toggleExtra">{{item.result === '异常' ? '异常处理进展（选填）' : '处理进展（选填）'}}　{{item.extraOpen ? '⌃' : '⌄'}}</view>
    <view wx:if="{{item.extraOpen}}"><block wx:if="{{!cadenceMode}}"><text class="label">记录日期</text><picker mode="date" value="{{item.recordDate}}" start="{{record.week_start}}" end="{{weekEnd}}" disabled="{{!item.canEdit || busy}}" data-index="{{index}}" data-field="recordDate" bindchange="onField"><view class="picker-field">{{item.recordDate || '选择日期'}}　⌄</view></picker></block><text class="label">处理进展</text><textarea value="{{item.action}}" maxlength="4000" disabled="{{!item.canEdit || busy}}" data-index="{{index}}" data-field="action" bindinput="onField" auto-height cursor-spacing="110" /></view>
   </view>
  </view></block></scroll-view><view class="item-editor-footer"><button wx:if="{{canEditActive}}" disabled="{{busy}}" bindtap="saveItem">保存并返回周表</button><button wx:if="{{canEditActive && nextItemId}}" class="primary" disabled="{{busy}}" data-next="true" bindtap="saveItem">保存并填下一项</button><button wx:if="{{!canEditActive}}" bindtap="closeItem">返回周表</button></view></view></view>
  <view wx:if="{{reportFilter !== 'all' && !visibleCount}}" class="empty">暂无事项</view>
  <view class="panel"><view class="section-heading">本周总结</view><button wx:if="{{editable}}" disabled="{{busy || summaryQuota && !summaryQuota.unlimited && summaryQuota.remaining <= 0}}" bindtap="generateSummary">{{summary ? 'AI 重新生成周总结' : 'AI 生成周总结'}}</button><text wx:if="{{editable && summaryQuota}}" class="muted">{{summaryQuota.unlimited ? '系统管理员不限次数' : '今日剩余 ' + summaryQuota.remaining + ' / 3 次'}}</text><text class="muted">根据已保存填报生成，核对后保存提交</text><textarea value="{{summary}}" placeholder="主要工作和待跟进事项" maxlength="4000" disabled="{{!editable || busy}}" bindinput="onSummary" auto-height cursor-spacing="110" /></view>
  <view wx:if="{{canReview}}" class="panel"><view class="section-heading">负责人意见</view><textarea value="{{feedback}}" placeholder="需要补充的内容或复核意见" maxlength="4000" disabled="{{busy}}" bindinput="onFeedback" auto-height cursor-spacing="110" /></view>
  <view wx:if="{{photos.length}}" class="photo-management"><view class="extra-toggle" bindtap="toggleLibrary">本周图片（{{photos.length}}）　⌄</view><view wx:if="{{libraryOpen}}" class="photos"><view class="photo" wx:for="{{photos}}" wx:key="id"><image src="{{item.src}}" mode="aspectFill" data-src="{{item.src}}" bindtap="previewPhoto" /><view><text>图片 {{item.id}}</text><text wx:if="{{editable && !record.submitted_at && item.report_id === record.id}}" class="danger" data-id="{{item.id}}" bindtap="deletePhoto">删除</text></view></view></view></view>
  <view class="actions"><button wx:if="{{!editable && record.id}}" disabled="{{busy}}" bindtap="exportReport">导出周表</button><button wx:if="{{editable}}" disabled="{{busy || !dirty}}" data-submit="false" bindtap="save">{{dirty ? '保存草稿' : '已保存'}}</button><button wx:if="{{editable}}" class="primary" disabled="{{busy}}" data-submit="true" bindtap="save">提交材料</button><button wx:if="{{isOwner && record.status === 'submitted'}}" disabled="{{busy}}" data-action="withdraw" bindtap="action">撤回修改</button><button wx:if="{{canReview && record.status === 'submitted'}}" disabled="{{busy}}" data-action="return" bindtap="action">退回补充</button><button wx:if="{{canReview && record.status === 'submitted'}}" class="primary" disabled="{{busy}}" data-action="confirm" bindtap="action">确认材料</button><button wx:if="{{canReview && record.status === 'confirmed'}}" disabled="{{busy}}" data-action="reopen" bindtap="action">重新打开</button></view>
 </block>
</view>
