.portal{display:flex;flex-direction:column;width:100%;min-height:100vh;padding:30rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f6f9;color:#26354a}.business-list,.business-group{width:100%;min-width:0}.business-group{margin-bottom:30rpx}.group-title{display:block;font-size:24rpx;font-weight:500;line-height:1.5;color:#8793a5;margin:0 8rpx 16rpx}.business-row{display:flex;align-items:center;gap:22rpx;width:100%;min-height:144rpx;box-sizing:border-box;margin:0 0 18rpx;padding:28rpx 26rpx;border:1rpx solid #e0e6ef;border-radius:22rpx;background:white;box-shadow:0 5rpx 20rpx #26354a04}.business-pressed{background:#eef1f7}.business-symbol{display:flex;align-items:center;justify-content:center;flex:0 0 80rpx;width:80rpx;height:80rpx;border-radius:22rpx;background:#f9ecee;color:#bb2538;font-size:32rpx;font-weight:600}.purple .business-symbol{background:#eeeefa;color:#6263a8}.green .business-symbol{background:#e9f5f1;color:#22867b}.business-copy{display:flex;flex-direction:column;gap:10rpx;flex:1;min-width:0;text-align:left}.business-title{display:block;font-size:29rpx;font-weight:600;line-height:1.5;color:#26354a}.business-description{display:block;font-size:23rpx;font-weight:400;line-height:1.6;color:#8b96a7}.business-arrow{display:block;flex:0 0 22rpx;font-size:36rpx;font-weight:400;line-height:1.2;color:#a3aebe;text-align:right}.account-area{width:100%;margin-top:auto;padding-top:24rpx}.account-row{display:flex;align-items:center;gap:20rpx;width:100%;min-height:104rpx;padding:20rpx 26rpx;box-sizing:border-box;border:1rpx solid #e0e6ef;border-radius:20rpx;background:white;font-size:28rpx;font-weight:500}.account-symbol{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:18rpx;background:#f0f2f6;color:#7e8b9e;font-size:24rpx}.account-row>.business-arrow{margin-left:auto}
