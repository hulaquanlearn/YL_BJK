<view class="portal"><view class="business-list"><view wx:for="{{groups}}" wx:for-item="group" wx:key="title" class="business-group"><text class="group-title">{{group.title}}</text><view wx:for="{{group.items}}" wx:for-item="item" wx:key="id" class="business-row {{item.tone}}" aria-role="button" hover-class="business-pressed" data-id="{{item.id}}" bindtap="openFeature"><view class="business-symbol">{{item.symbol}}</view><view class="business-copy"><text class="business-title">{{item.title}}</text><text class="business-description">{{item.description}}</text></view><text class="business-arrow">›</text></view></view></view><view class="account-area"><view class="account-row" aria-role="button" hover-class="business-pressed" bindtap="openAccount"><view class="account-symbol">我</view><text>我的账号</text><text class="business-arrow">›</text></view></view></view>
