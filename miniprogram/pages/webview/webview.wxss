.error{padding:72rpx 32rpx;color:#69778d;font-size:27rpx;line-height:1.7}.error-title{display:block;font-size:36rpx;font-weight:700;color:#24334a}.error-detail{display:block;margin-top:20rpx;word-break:break-all}.error-card{padding:28rpx;margin-top:32rpx;border:1rpx solid #e1e7ef;border-radius:20rpx;background:#fff}.error-label{display:block;font-size:24rpx}.error-url{display:block;margin-top:8rpx;word-break:break-all;color:#36445b}.error-tip{display:block;margin-top:24rpx;font-size:25rpx}.error-actions{display:flex;gap:20rpx;margin-top:28rpx}.error-actions button{display:flex;flex:1;align-items:center;justify-content:center;width:auto;min-width:0;height:88rpx;margin:0;padding:0 12rpx;border-radius:14rpx;font-size:27rpx;background:white;color:#6263a8;line-height:1.2}.error-actions .retry{background:#6263a8;color:white}
