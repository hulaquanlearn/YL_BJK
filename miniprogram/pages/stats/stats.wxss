.stats-page { min-height: 100vh; padding: 24rpx 24rpx 56rpx; background: #f4f6f8; color: #202936; }
.loading-card, .card { margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid #eceff3; border-radius: 22rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(31,42,55,.05); }
.loading-card, .empty { color: #8a929e; font-size: 26rpx; text-align: center; }
.summary-grid { display: flex; gap: 14rpx; margin-bottom: 24rpx; }
.summary-card { display: flex; min-width: 0; flex: 1; padding: 28rpx 12rpx; align-items: center; flex-direction: column; border: 1rpx solid #eceff3; border-radius: 20rpx; background: #fff; }
.summary-card.warning { border-color: #ffd5b0; background: #fff9f3; }
.summary-value { color: #202936; font-size: 42rpx; font-weight: 750; }
.summary-card.warning .summary-value { color: #c25b12; }
.summary-label { margin-top: 8rpx; color: #6f7885; font-size: 25rpx; }
.card-heading { display: flex; margin-bottom: 22rpx; align-items: center; justify-content: space-between; }
.section-title, .section-desc { display: block; }
.section-title { font-size: 31rpx; font-weight: 700; }
.section-desc { margin-top: 6rpx; color: #7b8491; font-size: 24rpx; }
.section-link { color: #c6000b; font-size: 25rpx; font-weight: 650; }
.unit-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.unit-item { min-width: 130rpx; padding: 20rpx; flex: 1; border-radius: 16rpx; background: #f7f8fa; text-align: center; }
.unit-total, .unit-name { display: block; }
.unit-total { color: #c6000b; font-size: 34rpx; font-weight: 700; }
.unit-name { margin-top: 5rpx; color: #69727f; font-size: 24rpx; }
.distribution-row { display: flex; min-height: 92rpx; padding: 18rpx 4rpx; align-items: center; border-bottom: 1rpx solid #eef0f3; }
.distribution-main { min-width: 0; flex: 1; }
.distribution-name, .distribution-meta { display: block; }
.distribution-name { font-size: 27rpx; font-weight: 650; }
.distribution-meta { margin-top: 5rpx; color: #8a929d; font-size: 23rpx; }
.distribution-stock { max-width: 270rpx; color: #4c5664; font-size: 24rpx; text-align: right; }
.chevron { margin-left: 12rpx; color: #9aa1aa; font-size: 28rpx; }
.shelf-list { padding-left: 22rpx; background: #fafbfc; }
.shelf-row .distribution-name { font-weight: 550; }
.layer-list { padding-left: 24rpx; }
.layer-row { min-height: 72rpx; }
.low-item { display: flex; padding: 20rpx 0; align-items: center; border-bottom: 1rpx solid #eef0f3; }
.low-main { min-width: 0; flex: 1; padding-right: 18rpx; }
.low-name, .low-location { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.low-name { font-size: 27rpx; font-weight: 650; }
.low-location { margin-top: 6rpx; color: #858e9a; font-size: 23rpx; }
.replenish-tip { display: block; margin-top: 7rpx; color: #9b5b13; font-size: 23rpx; }
.low-stock { flex: none; padding: 8rpx 14rpx; border-radius: 18rpx; color: #b54b0d; background: #fff0e2; font-size: 23rpx; font-weight: 650; }
.export-btn { display: flex; height: 88rpx; margin: 0; padding: 0; align-items: center; justify-content: center; border-radius: 16rpx; color: #fff; background: #c6000b; font-size: 29rpx; font-weight: 700; line-height: 1.2; }
