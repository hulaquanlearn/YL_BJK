.container {
  min-height: 100vh;
  padding: 24rpx 24rpx 70rpx;
  box-sizing: border-box;
  color: #202936;
  background: #f4f6f8;
}

.search-row {
  display: flex;
  margin-bottom: 18rpx;
  align-items: center;
  gap: 12rpx;
}

.search-container {
  position: relative;
  min-width: 0;
  flex: 1;
}

.search-input {
  width: 100%;
  height: 76rpx;
  padding: 0 98rpx 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e1e6eb;
  border-radius: 18rpx;
  color: #27313d;
  background: #fff;
  font-size: 26rpx;
}

.clear-btn {
  position: absolute;
  top: 0;
  right: 20rpx;
  height: 76rpx;
  color: #8b949f;
  font-size: 23rpx;
  line-height: 76rpx;
}

.search-submit {
  display: flex;
  width: 112rpx;
  height: 76rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #fff;
  background: #c6000b;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.2;
}

.search-submit::after,
.empty-reset::after { border: 0; }

.low-stock-banner {
  display: flex;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #f1d4b9;
  border-radius: 16rpx;
  color: #9a4b0d;
  background: #fff6ed;
  font-size: 25rpx;
  font-weight: 650;
}

.low-stock-desc { color: #b17a50; font-size: 21rpx; font-weight: 400; }

.filter-toolbar {
  display: flex;
  margin-bottom: 14rpx;
  padding: 14rpx 18rpx;
  align-items: center;
  border: 1rpx solid #e7eaee;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(31, 41, 55, .04);
}

.filter-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 10rpx;
}

.filter-title-row { display: flex; align-items: center; gap: 7rpx; }
.filter-title { font-size: 26rpx; font-weight: 700; }
.filter-count {
  width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  color: #fff;
  background: #c6000b;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
}
.filter-summary {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #7c8591;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filter-toggle { flex: none; color: #9f1820; font-size: 22rpx; }

.sort-compact {
  display: flex;
  width: 176rpx;
  margin-left: 12rpx;
  padding-left: 12rpx;
  flex-direction: column;
  border-left: 1rpx solid #edf0f3;
}
.sort-caption { color: #929aa4; font-size: 19rpx; }
.sort-current {
  margin-top: 4rpx;
  overflow: hidden;
  color: #394452;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-panel {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #eadfe0;
  border-radius: 18rpx;
  background: #fff;
}
.filter-panel-head {
  display: flex;
  padding-bottom: 15rpx;
  align-items: center;
  justify-content: space-between;
  color: #495462;
  font-size: 24rpx;
  font-weight: 650;
}
.filter-close { color: #8c96a3; font-size: 34rpx; line-height: 1; }
.filter-line {
  display: block;
  min-width: 0;
  padding: 12rpx 0;
  align-items: center;
  border-top: 1rpx solid #f0f2f4;
}
.filter-label {
  display: block;
  margin-bottom: 12rpx;
  color: #717b87;
  font-size: 23rpx;
}
.filter-options, .tag-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.filter-scroll { width: 100%; max-height: 300rpx; }
.tag {
  display: flex;
  min-height: 62rpx;
  min-width: 0;
  padding: 10rpx 12rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e3e7eb;
  border-radius: 12rpx;
  color: #606a76;
  background: #f8f9fa;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}
.tag.active {
  border-color: #c6000b;
  color: #a8121b;
  background: #fff0f1;
  font-weight: 650;
}
.filter-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.filter-actions button { display: flex; height: 68rpx; min-height: 68rpx; margin: 0; padding: 0; flex: 1; align-items: center; justify-content: center; border-radius: 12rpx; font-size: 25rpx; line-height: 1.2; }
.filter-reset-button { color: #4b5563; background: #f0f2f5; }
.filter-apply-button { color: #fff; background: #c6000b; }

.result-bar {
  display: flex;
  padding: 18rpx 2rpx 14rpx;
  align-items: flex-end;
  justify-content: space-between;
}
.result-title { font-size: 29rpx; font-weight: 750; }
.result-total { margin-left: 12rpx; color: #87909b; font-size: 22rpx; }
.result-count { color: #9aa2ac; font-size: 21rpx; }

.part-card,
.skeleton-card {
  margin-bottom: 14rpx;
  padding: 22rpx;
  border: 1rpx solid #e8ebef;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 5rpx 16rpx rgba(31, 41, 55, .035);
}
.part-card-hover { background: #fffafa; transform: scale(.995); }
.part-card-head { display: flex; align-items: flex-start; gap: 18rpx; }
.part-heading { min-width: 0; flex: 1; }
.part-name {
  display: -webkit-box;
  overflow: hidden;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.material-code { display: block; margin-top: 8rpx; color: #7f8995; font-size: 22rpx; }

.stock-badge {
  min-width: 112rpx;
  padding: 11rpx 12rpx;
  flex: 0 0 auto;
  border-radius: 14rpx;
  text-align: right;
}
.stock-badge.normal { color: #177b55; background: #eaf8f2; }
.stock-badge.low { color: #b16400; background: #fff4da; }
.stock-badge.zero { color: #b51b25; background: #ffebed; }
.stock-status,
.stock-value { display: block; white-space: nowrap; }
.stock-status { font-size: 19rpx; }
.stock-value { margin-top: 3rpx; font-size: 28rpx; font-weight: 750; }

.spec-row,
.brand-row {
  display: flex;
  margin-top: 15rpx;
  min-width: 0;
  align-items: flex-start;
}
.spec-label,
.brand-label {
  width: 112rpx;
  flex: 0 0 112rpx;
  color: #9098a2;
  font-size: 22rpx;
}
.spec-value,
.brand-value {
  min-width: 0;
  flex: 1;
  color: #47515e;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}
.spec-value { color: #283441; font-weight: 600; }

.part-location-row {
  display: grid;
  margin-top: 17rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f4;
  grid-template-columns: auto 1fr auto;
  align-items: start;
  gap: 12rpx;
}
.location-label { color: #9a4f54; font-size: 21rpx; }
.part-location { color: #747e8a; font-size: 22rpx; line-height: 1.45; }
.detail-link { color: #b01821; font-size: 22rpx; font-weight: 650; }

.pagination-state {
  padding: 28rpx 0 18rpx;
  color: #8e97a2;
  font-size: 22rpx;
  text-align: center;
}

.empty {
  display: flex;
  padding: 90rpx 20rpx;
  align-items: center;
  flex-direction: column;
}
.empty-title { color: #5b6673; font-size: 28rpx; font-weight: 700; }
.empty-desc { margin-top: 10rpx; color: #969ea8; font-size: 23rpx; }
.empty-reset {
  width: 220rpx;
  height: 68rpx;
  min-height: 68rpx;
  margin-top: 24rpx;
  border: 1rpx solid #d7b6b8;
  border-radius: 34rpx;
  color: #a8121b;
  background: #fff;
  font-size: 24rpx;
  line-height: 68rpx;
}

.skeleton-line {
  height: 23rpx;
  margin-bottom: 17rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #eef1f4 20%, #f8f9fa 50%, #eef1f4 80%);
  background-size: 200% 100%;
  animation: skeleton 1.25s infinite;
}
.skeleton-line:last-child { margin-bottom: 0; }
.skeleton-line.wide { width: 78%; }
.skeleton-line.medium { width: 52%; }
.skeleton-line.narrow { width: 66%; }

@keyframes skeleton {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.load-error{padding:24rpx;background:#fff7ed;border-radius:16rpx;color:#9a3412;display:flex;align-items:center;gap:16rpx}.load-error button{font-size:26rpx;flex-shrink:0;margin:0;}
