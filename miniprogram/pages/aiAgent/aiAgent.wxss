.assistant-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 64rpx;
  box-sizing: border-box;
  color: #202936;
  background: #f4f6f8;
}

.assistant-hero {
  padding: 28rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #9f0009, #d8232e);
  box-shadow: 0 14rpx 30rpx rgba(174, 0, 11, .18);
}
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.hero-title,
.hero-desc { display: block; }
.hero-title { font-size: 36rpx; font-weight: 750; }
.hero-desc { margin-top: 9rpx; color: rgba(255,255,255,.82); font-size: 24rpx; line-height: 1.5; }
.smart-badge {
  padding: 8rpx 14rpx;
  flex: none;
  border: 1rpx solid rgba(255,255,255,.36);
  border-radius: 22rpx;
  color: #fff;
  background: rgba(255,255,255,.12);
  font-size: 20rpx;
}
.scope-row { display: flex; margin-top: 22rpx; gap: 10rpx; }
.scope-row text {
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  color: rgba(255,255,255,.9);
  background: rgba(91,0,5,.23);
  font-size: 20rpx;
}

.input-card,
.result-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e7eaee;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(31,42,55,.04);
}
.input-box {
  width: 100%;
  min-height: 190rpx;
  color: #2d3744;
  font-size: 28rpx;
  line-height: 1.65;
}
.input-footer {
  display: flex;
  padding-top: 15rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #edf0f3;
}
.scope-tip { color: #7d8692; font-size: 22rpx; }
.clear-history { color: #a81720; font-size: 22rpx; }

.suggestions { margin: 20rpx 0; }
.suggestion-title { display: block; margin-bottom: 10rpx; color: #747e8a; font-size: 22rpx; }
.maintenance-title { margin-top: 13rpx; }
.suggestion-scroll { width: 100%; white-space: nowrap; }
.suggestion-row { display: inline-flex; padding-right: 18rpx; gap: 10rpx; }
.suggestion-chip {
  display: inline-block;
  padding: 12rpx 18rpx;
  border: 1rpx solid #ead5d7;
  border-radius: 26rpx;
  color: #8f1119;
  background: #fff7f7;
  font-size: 22rpx;
}
.suggestion-chip.maintenance {
  border-color: #d9e1e8;
  color: #52606e;
  background: #fff;
}

.query-btn {
  height: 86rpx;
  min-height: 86rpx;
  border-radius: 17rpx;
  color: #fff;
  background: #c6000b;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 86rpx;
  box-shadow: 0 8rpx 18rpx rgba(198,0,11,.2);
}
.query-btn[disabled] { color: rgba(255,255,255,.82); background: #d27a80; box-shadow: none; }
.query-btn::after,
.clarification-btn::after { border: 0; }

.result-heading {
  display: flex;
  padding-bottom: 17rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf0f3;
}
.result-title { font-size: 29rpx; font-weight: 750; }
.source-badge {
  padding: 7rpx 13rpx;
  border-radius: 18rpx;
  color: #8f1119;
  background: #fff0f1;
  font-size: 20rpx;
}
.result-content {
  display: block;
  padding-top: 18rpx;
  color: #394452;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-line;
  word-break: break-word;
}

.summary-box {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e6d4d6;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #fff7f7, #fff);
}
.summary-value { color: #a90e18; font-size: 52rpx; font-weight: 800; }
.summary-label { margin-left: 10rpx; color: #4f5966; font-size: 25rpx; }
.summary-detail { display: block; margin-top: 8rpx; color: #828b96; font-size: 22rpx; }

.clarification-list { display: flex; padding-top: 18rpx; flex-wrap: wrap; gap: 12rpx; }
.clarification-btn {
  min-width: 180rpx;
  height: 68rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #dab9bc;
  border-radius: 34rpx;
  color: #a71620;
  background: #fff;
  font-size: 23rpx;
  line-height: 68rpx;
}

.inventory-result-list { margin-top: 18rpx; }
.inventory-result-card {
  position: relative;
  margin-bottom: 14rpx;
  padding: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e7eaee;
  border-radius: 17rpx;
  background: #fafbfc;
}
.inventory-card-hover { background: #fff7f7; }
.inventory-card-head { display: flex; align-items: flex-start; gap: 14rpx; }
.inventory-card-title { min-width: 0; flex: 1; }
.inventory-name {
  display: -webkit-box;
  overflow: hidden;
  color: #202b38;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.inventory-code { display: block; margin-top: 6rpx; color: #858e99; font-size: 21rpx; }
.inventory-stock {
  min-width: 104rpx;
  padding: 9rpx 10rpx;
  flex: none;
  border-radius: 12rpx;
  text-align: right;
}
.inventory-stock.normal { color: #147850; background: #e9f8f2; }
.inventory-stock.low { color: #a75b00; background: #fff2d4; }
.inventory-stock.zero { color: #b11923; background: #ffe9eb; }
.inventory-stock.unknown { color: #667085; background: #eef1f5; }
.inventory-stock-state,
.inventory-stock-value { display: block; white-space: nowrap; }
.inventory-stock-state { font-size: 18rpx; }
.inventory-stock-value { margin-top: 2rpx; font-size: 25rpx; font-weight: 750; }
.inventory-spec,
.inventory-location {
  display: flex;
  margin-top: 13rpx;
  min-width: 0;
  align-items: flex-start;
}
.inventory-meta-label {
  width: 106rpx;
  flex: 0 0 106rpx;
  color: #949ca6;
  font-size: 21rpx;
}
.inventory-meta-value {
  min-width: 0;
  flex: 1;
  color: #4d5865;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}
.inventory-spec .inventory-meta-value { color: #2d3946; font-weight: 600; }
.card-action {
  display: block;
  margin-top: 14rpx;
  padding-top: 13rpx;
  border-top: 1rpx solid #eceff2;
  color: #a51620;
  font-size: 21rpx;
  text-align: right;
}

.safety-note {
  display: block;
  margin-top: 18rpx;
  padding: 17rpx;
  border-radius: 14rpx;
  color: #855800;
  background: #fff7e5;
  font-size: 22rpx;
  line-height: 1.55;
}
.evidence-list{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #e7eaee}.evidence-heading{display:block;color:#344054;font-size:25rpx;font-weight:700}.evidence-list button{margin:12rpx 0 0;padding:17rpx;border-radius:12rpx;text-align:left;color:#344054;background:#f4f7fa;font-size:24rpx;line-height:1.6}.evidence-list button::after{border:0}.evidence-list button text{display:block}.evidence-excerpt{margin-top:6rpx;color:#7c8796;font-size:22rpx;display:-webkit-box!important;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.evidence-empty{display:block;margin-top:20rpx;color:#8a6425;font-size:22rpx}
