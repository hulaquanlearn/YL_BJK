<view class="container">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{isLoading && approveList.length === 0}}">
    <text>加载待审批盘点单...</text>
  </view>

  <!-- 无数据提示 -->
  <view class="empty-tip" wx:elif="{{approveList.length === 0}}">
    <text>暂无待审批的盘点单</text>
  </view>

  <!-- 待审批列表 -->
  <scroll-view class="list-scroll" scroll-y wx:else bindscrolltolower="loadMore">
    <view class="empty-tip">待审批共 {{total}} 条</view>
    <view class="approve-item" wx:for="{{approveList}}" wx:key="_id">
      <!-- 盘点单标题栏（移除内联样式，统一通过WXSS控制） -->
      <view class="item-header">
        <view class="order-info">
          <text class="label">盘点单号：</text>
          <text class="value">{{item.inventoryNo}}</text>
        </view>
        <view class="order-info">
          <text class="label">创建时间：</text>
          <text class="value">{{item.createTime}}</text>
        </view>
      </view>
      <view class="divider"></view>
      
      <!-- 筛选条件（兜底默认值，防止字段为空报错） -->
      <view class="filter-info">
        <text class="info-item">工段：{{item.filterParams.workshop || '全部'}}</text>
        <text class="info-item">货架：{{item.filterParams.shelf || '全部'}}</text>
        <text class="info-item">层数：{{item.filterParams.layer || '全部'}}</text>
      </view>
      
      <!-- 盘点人/说明（兜底默认值，提升页面兼容性） -->
      <view class="base-info">
        <text class="info-item">盘点人：{{item.inventoryUser}}</text>
        <text class="info-item">盘点说明：{{item.inventoryRemark || '无说明'}}</text>
      </view>
      
      <!-- 异常备件明细（加宽备件名称列+空数据提示，优化体验） -->
      <view class="abnormal-wrap">
        <view class="abnormal-title">异常备件明细</view>
        <view class="abnormal-table" wx:if="{{item.abnormalList.length > 0}}">
          <view class="table-header">
            <text class="col-name">备件名称</text>
            <text class="col-code">物料编码</text>
            <text class="col-stock">系统数量</text>
            <text class="col-actual">实际数量</text>
          </view>
          <!-- wx:key优化：改用partId（唯一），避免materialCode重复导致的警告 -->
          <view class="table-row" wx:for="{{item.abnormalList}}" wx:for-item="part" wx:key="partId">
            <text class="col-name">{{part.partName}}</text>
            <text class="col-code">{{part.materialCode}}</text>
            <text class="col-stock">{{part.sysStock}}</text>
            <text class="col-actual">{{part.actualStockWithUnit}}</text>
          </view>
        </view>
        <!-- 空异常备件提示，避免页面空白 -->
        <view class="no-abnormal-tip" wx:else>
          <text>该盘点单无异常备件</text>
        </view>
      </view>
      
      <view class="operate-wrap" wx:if="{{!isViewer && item._id}}">
        <button class="reject-btn" bindtap="rejectOrder" data-id="{{item._id}}" disabled="{{processingOrderId}}">驳回</button>
        <button class="pass-btn" bindtap="passOrder" data-id="{{item._id}}" disabled="{{processingOrderId}}">通过</button>
      </view>
      <view class="no-permission" wx:elif="{{!item._id}}">
        <text>盘点单ID无效，无法操作</text>
      </view>
    </view>
    <button wx:if="{{hasMore}}" bindtap="loadMore" loading="{{isLoading}}" disabled="{{isLoading}}">加载更多</button>
    <view class="empty-tip" wx:else>已加载全部 {{total}} 条</view>
  </scroll-view>
</view>
