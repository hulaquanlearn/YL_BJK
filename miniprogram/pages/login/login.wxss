page { min-height: 100%; background: #f4f5f7; }
.login-page { min-height: 100vh; padding: 110rpx 44rpx 60rpx; box-sizing: border-box; background: linear-gradient(160deg, #c6000b 0, #8f1119 36%, #f4f5f7 36.2%); }
.brand-block { display: flex; flex-direction: column; align-items: center; color: #fff; }
.brand-icon { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 30rpx; background: rgba(255,255,255,.18); font-size: 48rpx; font-weight: 700; }
.brand-title { margin-top: 28rpx; font-size: 40rpx; font-weight: 700; }
.brand-subtitle { margin-top: 12rpx; color: rgba(255,255,255,.78); font-size: 25rpx; }
.login-card { margin-top: 70rpx; padding: 42rpx 36rpx 36rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 18rpx 48rpx rgba(35,26,27,.12); }
.field-group { margin-bottom: 30rpx; }
.field-label { display: block; margin-bottom: 14rpx; color: #303442; font-size: 27rpx; font-weight: 600; }
.field-input { width: 100%; height: 92rpx; padding: 0 26rpx; box-sizing: border-box; border: 2rpx solid #e5e7eb; border-radius: 16rpx; background: #fafafa; font-size: 29rpx; }
.password-row { position: relative; }
.password-input { padding-right: 110rpx; }
.password-toggle { position: absolute; right: 24rpx; top: 0; height: 92rpx; display: flex; align-items: center; color: #c6000b; font-size: 25rpx; }
.login-button { display: flex; width: 100%; height: 92rpx; margin: 12rpx 0 0; padding: 0; align-items: center; justify-content: center; border: 0; border-radius: 16rpx; color: #fff; background: #c6000b; font-size: 31rpx; font-weight: 700; line-height: 1.2; }
.login-button::after { border: 0; }
.login-button[disabled] { color: rgba(255,255,255,.8); background: #d76970; }
.security-tip { display: block; margin-top: 24rpx; color: #8a909d; font-size: 23rpx; line-height: 1.6; text-align: center; }
.form-error { display: block; margin-top: 18rpx; color: #b42318; font-size: 25rpx; line-height: 1.5; text-align: center; }
