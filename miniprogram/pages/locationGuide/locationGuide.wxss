.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #C6000B, #e63946);
}

.image-wrap {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guide-image {
  width: 100%;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #000;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: rgba(0, 0, 0, 0.5);
}

.preview-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

.preview-close {
  font-size: 36rpx;
  color: #fff;
  padding: 10rpx 20rpx;
}

.preview-swiper {
  flex: 1;
  width: 100%;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-indicator {
  text-align: center;
  padding: 20rpx;
  background: rgba(0, 0, 0, 0.5);
}

.preview-indicator text {
  font-size: 28rpx;
  color: #fff;
}
