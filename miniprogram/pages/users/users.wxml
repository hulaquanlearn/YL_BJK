<view class="page-wrap">
  <view class="head-card">
    <view><text class="head-title">系统账号</text><text class="head-desc">管理员可创建账号并分配权限</text></view>
    <button class="add-btn" bindtap="openCreate">新增账号</button>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载账号...</view>
  <view class="user-list" wx:else>
    <view class="user-card" wx:for="{{users}}" wx:key="id">
      <view class="user-main">
        <view class="avatar">{{item.initial}}</view>
        <view class="user-info"><text class="user-name">{{item.displayName}}</text><text class="user-meta">{{item.username}} · {{item.roleLabel}}</text></view>
        <view wx:if="{{isViewer}}" class="readonly-switch {{item.enabled ? 'is-enabled' : ''}}" catchtap="denyWrite" aria-label="{{item.enabled ? '账号已启用' : '账号已停用'}}"><view class="switch-knob" /></view>
        <switch wx:else checked="{{item.enabled}}" color="#C6000B" data-id="{{item.id}}" bindchange="toggleEnabled" />
      </view>
      <view class="action-row">
        <view wx:if="{{isViewer}}" class="action-btn" bindtap="denyWrite">修改角色</view>
        <picker wx:else range="{{roles}}" value="{{item.roleIndex}}" data-id="{{item.id}}" bindchange="changeRole"><view class="action-btn">修改角色</view></picker>
        <view class="action-btn danger" data-id="{{item.id}}" bindtap="openReset">重置密码</view>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showCreate}}" catchtap="closeCreate">
    <view class="modal" catchtap="noop">
      <text class="modal-title">新增账号</text>
      <input class="input" placeholder="用户名：小写字母、数字或下划线" value="{{newUser.username}}" data-field="username" bindinput="onNewInput" />
      <input class="input" placeholder="姓名" value="{{newUser.displayName}}" data-field="displayName" bindinput="onNewInput" />
      <input class="input" password placeholder="初始密码：含大小写字母及数字" value="{{newUser.password}}" data-field="password" bindinput="onNewInput" />
      <picker range="{{roles}}" value="{{newRoleIndex}}" bindchange="onNewRole"><view class="picker-input">角色：{{roles[newRoleIndex]}}</view></picker>
      <view class="modal-actions"><button class="cancel" bindtap="closeCreate">取消</button><button class="confirm" loading="{{submitting}}" bindtap="createUser">创建</button></view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showReset}}" catchtap="closeReset">
    <view class="modal" catchtap="noop">
      <text class="modal-title">重置 {{resetUser.displayName}} 的密码</text>
      <text class="modal-tip">重置后，该账号现有登录会立即失效。</text>
      <input class="input" password placeholder="新密码：含大小写字母及数字" value="{{resetPassword}}" bindinput="onResetInput" />
      <view class="modal-actions"><button class="cancel" bindtap="closeReset">取消</button><button class="confirm" loading="{{submitting}}" bindtap="confirmReset">确认重置</button></view>
    </view>
  </view>
</view>
