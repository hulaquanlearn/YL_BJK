page{background:#f4f5f7}.page-wrap{padding:28rpx}.head-card,.user-card{border-radius:20rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(25,29,40,.05)}.head-card{display:flex;align-items:center;justify-content:space-between;padding:28rpx}.head-title,.head-desc{display:block}.head-title{font-size:32rpx;font-weight:700;color:#252a37}.head-desc{margin-top:7rpx;color:#8a909d;font-size:23rpx}.add-btn{height:70rpx;margin:0;padding:0 24rpx;border:0;border-radius:13rpx;color:#fff;background:#c6000b;line-height:70rpx;font-size:25rpx}.add-btn::after,.modal-actions button::after{border:0}.loading{padding:100rpx 0;text-align:center;color:#8a909d}.user-card{margin-top:18rpx;padding:26rpx}.user-main{display:flex;align-items:center}.avatar{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;color:#fff;background:#c6000b;font-size:31rpx;font-weight:700}.user-info{flex:1;margin-left:20rpx}.user-name,.user-meta{display:block}.user-name{color:#252a37;font-size:29rpx;font-weight:700}.user-meta{margin-top:6rpx;color:#8a909d;font-size:23rpx}.action-row{display:flex;gap:16rpx;margin-top:22rpx;padding-top:20rpx;border-top:2rpx solid #f0f1f3}.action-row picker{flex:1}.action-btn{height:64rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx;color:#3f4a5a;background:#f2f4f7;font-size:24rpx}.action-btn.danger{flex:1;color:#b21823;background:#fff0f1}.modal-mask{position:fixed;z-index:99;inset:0;display:flex;align-items:center;justify-content:center;padding:36rpx;background:rgba(17,21,28,.48)}.modal{width:100%;padding:36rpx;border-radius:24rpx;background:#fff;box-sizing:border-box}.modal-title{display:block;margin-bottom:26rpx;color:#252a37;font-size:32rpx;font-weight:700}.modal-tip{display:block;margin:-12rpx 0 22rpx;color:#8a909d;font-size:23rpx}.input,.picker-input{height:84rpx;margin-bottom:18rpx;padding:0 22rpx;border:2rpx solid #e5e7eb;border-radius:14rpx;background:#fafafa;box-sizing:border-box;font-size:26rpx}.picker-input{display:flex;align-items:center;color:#3f4654}.modal-actions{display:flex;gap:18rpx;margin-top:28rpx}.modal-actions button{flex:1;height:80rpx;margin:0;border:0;border-radius:14rpx;line-height:80rpx;font-size:27rpx}.cancel{color:#4f5968;background:#f1f3f5}.confirm{color:#fff;background:#c6000b}
.readonly-switch { width: 96rpx; height: 56rpx; padding: 4rpx; box-sizing: border-box; border-radius: 32rpx; background: #d8dde4; flex-shrink: 0; }
.readonly-switch.is-enabled { background: #c6000b; }
.switch-knob { width: 48rpx; height: 48rpx; border-radius: 50%; background: #fff; box-shadow: 0 2rpx 4rpx rgba(0,0,0,.12); }
.readonly-switch.is-enabled .switch-knob { margin-left: 40rpx; }
.add-btn,.modal-actions button{display:flex;align-items:center;justify-content:center;line-height:1.2;padding-top:0;padding-bottom:0}
.action-row>.action-btn{flex:1}
.modal{max-height:calc(100vh - 72rpx);overflow-y:auto}
