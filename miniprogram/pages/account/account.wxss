page { background: #f4f5f7; }
.page-wrap { padding: 28rpx; }
.profile-card,.menu-card,.form-card { border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(27,31,43,.05); }
.profile-card { display: flex; align-items: center; padding: 34rpx; }
.avatar { width: 88rpx; height: 88rpx; display:flex;align-items:center;justify-content:center;border-radius:26rpx;color:#fff;background:#c6000b;font-size:38rpx;font-weight:700; }
.profile-main { flex:1; margin-left:24rpx; }
.profile-name,.profile-meta { display:block; }
.profile-name { color:#222735;font-size:34rpx;font-weight:700; }
.profile-meta { margin-top:8rpx;color:#8b919e;font-size:24rpx; }
.role-badge { padding:8rpx 15rpx;border-radius:999rpx;color:#52606d;background:#edf1f5;font-size:22rpx; }
.role-badge.admin { color:#a20f19;background:#fff0f1; }
.menu-card { margin-top:22rpx;padding:0 28rpx; }
.menu-item { display:flex;align-items:center;justify-content:space-between;padding:28rpx 0; }
.menu-title,.menu-desc { display:block; }
.menu-title { font-size:29rpx;font-weight:600;color:#252a37; }
.menu-desc { margin-top:7rpx;font-size:23rpx;color:#8b919e; }
.arrow { color:#adb3bd;font-size:44rpx; }
.form-card { margin-top:22rpx;padding:32rpx; }
.section-title { display:block;font-size:31rpx;font-weight:700;color:#252a37; }
.section-tip { display:block;margin:8rpx 0 24rpx;color:#8b919e;font-size:23rpx; }
.input { height:88rpx;margin-bottom:18rpx;padding:0 24rpx;border:2rpx solid #e6e8ed;border-radius:15rpx;background:#fafafa;box-sizing:border-box;font-size:28rpx; }
.primary-btn { display:flex;height:88rpx;margin-top:8rpx;padding:0;align-items:center;justify-content:center;border:0;border-radius:15rpx;color:#fff;background:#c6000b;line-height:1.2;font-size:29rpx;font-weight:700; }
.primary-btn::after,.logout-btn::after { border:0; }
.logout-btn { display:flex;height:88rpx;margin-top:28rpx;padding:0;align-items:center;justify-content:center;border:2rpx solid #e2a2a7;border-radius:15rpx;color:#b41924;background:#fff;line-height:1.2;font-size:29rpx; }
