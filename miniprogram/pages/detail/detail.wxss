/* 页面整体容器 */
.detail-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx 20rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 导航栏样式 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background-color: #007AFF;
  color: #fff;
  padding: 0 30rpx;
  margin: -20rpx -20rpx 30rpx -20rpx;
  border-radius: 10rpx 10rpx 0 0;
}
.back-btn {
  font-size: 28rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: bold;
}

/* 通用卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.card-header {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f1f1f1;
}

/* 基本信息项样式（核心对齐逻辑） */
.card-item {
  display: flex;
  padding: 16rpx 0;
  align-items: center; /* 垂直居中，避免内容错位 */
}
/* 标签样式：固定宽度+左对齐，确保所有标签齐平 */
.card-item .label {
  display: inline-block;
  width: 150rpx; /* 固定宽度，适配2字/4字标签 */
  text-align: left; /* 标签文字左对齐，视觉统一 */
  color: #666;
  font-size: 28rpx;
  margin-right: 10rpx; /* 标签与内容间距，避免拥挤 */
}
/* 内容样式：占满剩余空间，自动换行 */
.card-item .value {
  color: #333;
  flex: 1; /* 占满剩余宽度 */
  font-size: 28rpx;
  word-break: break-all; /* 长文本自动换行，不溢出 */
}

/* 库存状态区域样式 */
.stock-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.stock-number {
  display: flex;
  align-items: baseline;
}
.number {
  font-size: 60rpx;
  font-weight: bold;
  color: #007AFF;
}
.unit {
  font-size: 32rpx;
  color: #666;
  margin-left: 8rpx;
}
.stock-status {
  font-size: 28rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.status-normal {
  background-color: #E6F7E9;
  color: #07C160;
}
.status-low {
  background-color: #FFF0F0;
  color: #F53F3F;
}
.stock-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  padding-top: 10rpx;
  border-top: 1rpx dashed #eee;
}
.stock-update {
  color: #999;
}

/* 库存调整：标签、输入框和操作按钮在同一基线上。 */
.operation-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.operation-item:last-child { margin-bottom: 0; }
.operation-label {
  flex: 0 0 132rpx;
  font-size: 26rpx;
  color: #666;
  text-align: left;
  white-space: nowrap;
  margin-right: 12rpx;
}
.operation-input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 76rpx;
  box-sizing: border-box;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 14rpx;
  font-size: 26rpx;
  color: #333;
  background-color: #f9f9f9;
  margin-right: 12rpx;
}

.stock-in, .stock-out {
  display: flex;
  flex: 0 0 170rpx;
  align-items: center;
  justify-content: center;
  width: 170rpx;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0;
  line-height: 1.2;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 600;
  margin: 0;
  border: none;
}
.stock-in::after, .stock-out::after { border: none; }
.stock-in {
  background-color: #07C160;
  color: #fff;
}
.stock-out {
  background-color: #F53F3F;
  color: #fff;
}

/* 备注信息样式 */
.remark-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  padding: 10rpx 0;
}

.operation-reason { margin-bottom: 24rpx; }
.reason-input { height: 82rpx; margin-top: 12rpx; padding: 0 20rpx; border: 2rpx solid #e3e7ec; border-radius: 14rpx; background: #f9fafb; font-size: 26rpx; }
.archive-btn { display: flex; align-items: center; justify-content: center; width: 360rpx; max-width: 100%; height: 84rpx; margin: 24rpx auto 0; padding: 0; border: 1rpx solid #d8dde4; border-radius: 16rpx; color: #9c2b32; background: #fff; font-size: 26rpx; line-height: 1.2; }
