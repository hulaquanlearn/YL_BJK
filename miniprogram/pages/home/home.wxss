.workbench {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background: #f4f6f8;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #a9000a 0%, #d8242f 58%, #ed5962 100%);
  box-shadow: 0 18rpx 42rpx rgba(174, 0, 11, 0.22);
}

.hero-decoration {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.hero-decoration-one { width: 260rpx; height: 260rpx; right: -70rpx; top: -120rpx; }
.hero-decoration-two { width: 150rpx; height: 150rpx; right: 120rpx; bottom: -110rpx; }

.hero-top, .hero-bottom, .greeting-row, .refresh-action,
.section-heading, .flow-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-top, .hero-bottom { position: relative; z-index: 1; }
.eyebrow {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
  letter-spacing: 2rpx;
}

.greeting-row { justify-content: flex-start; }
.greeting {
  max-width: 470rpx;
  overflow: hidden;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-pill {
  margin-left: 14rpx;
  padding: 5rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 18rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
}

.avatar {
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 82rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 82rpx;
  text-align: center;
}

.hero-bottom {
  margin-top: 36rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
}
.refresh-action { gap: 8rpx; }
.refresh-icon { font-size: 30rpx; line-height: 1; }

.metric-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.metric-card {
  display: flex;
  min-width: 0;
  flex: 1;
  padding: 22rpx 8rpx 20rpx;
  align-items: center;
  flex-direction: column;
  border: 1rpx solid #edf0f3;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(31, 42, 55, 0.05);
}
.metric-card-warning { border-color: #ffd9b3; background: #fffaf5; }
.metric-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 12rpx;
  border-radius: 13rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}
.metric-blue { color: #2769d8; background: #eaf2ff; }
.metric-green { color: #16845b; background: #e8f8f0; }
.metric-orange { color: #c25b12; background: #fff0e1; }
.metric-purple { color: #7650c7; background: #f2edff; }
.metric-value { color: #1f2937; font-size: 34rpx; font-weight: 750; line-height: 1.1; }
.metric-label { margin-top: 8rpx; color: #6f7885; font-size: 24rpx; white-space: nowrap; }

.error-card {
  display: flex;
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #ffd2d5;
  border-radius: 18rpx;
  background: #fff6f6;
}
.error-title, .error-desc { display: block; }
.error-title { color: #9e2028; font-size: 26rpx; font-weight: 650; }
.error-desc { margin-top: 5rpx; color: #a76d71; font-size: 21rpx; }
.error-action { color: #c6000b; font-size: 24rpx; font-weight: 650; }

.section { margin-top: 38rpx; }
.section-heading { margin-bottom: 18rpx; padding: 0 4rpx; }
.section-title, .section-subtitle { display: block; }
.section-title { color: #202936; font-size: 31rpx; font-weight: 700; }
.section-subtitle { margin-top: 5rpx; color: #9199a4; font-size: 22rpx; }
.section-link { color: #c6000b; font-size: 24rpx; font-weight: 600; }

.warning-card, .tool-list, .flow-card {
  overflow: hidden;
  border: 1rpx solid #edf0f3;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(31, 42, 55, 0.045);
}
.warning-item {
  display: flex;
  padding: 24rpx 26rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f2f4;
}
.warning-item:last-child { border-bottom: 0; }
.warning-main { min-width: 0; padding-right: 20rpx; }
.warning-name, .warning-location { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.warning-name { color: #27313f; font-size: 27rpx; font-weight: 650; }
.warning-location { margin-top: 7rpx; color: #929aa5; font-size: 21rpx; }
.stock-badge {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  color: #bd4c0c;
  background: #fff0e2;
  font-size: 22rpx;
  font-weight: 650;
}

.quick-grid { display: flex; gap: 12rpx; }
.quick-item {
  display: flex;
  min-width: 0;
  flex: 1;
  padding: 25rpx 8rpx 22rpx;
  align-items: center;
  flex-direction: column;
  border: 1rpx solid #edf0f3;
  border-radius: 20rpx;
  background: #fff;
}
.quick-icon {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  border-radius: 20rpx;
}
.quick-icon image { width: 42rpx; height: 42rpx; }
.icon-blue { background: #eaf2ff; }
.icon-green { background: #e8f8f0; }
.icon-orange { background: #fff0e1; }
.icon-purple { background: #f2edff; }
.quick-title { color: #2a3441; font-size: 25rpx; font-weight: 650; white-space: nowrap; }
.quick-desc { margin-top: 6rpx; color: #7f8792; font-size: 24rpx; white-space: nowrap; }

.tool-item {
  display: flex;
  min-height: 116rpx;
  padding: 20rpx 24rpx;
  align-items: center;
  border-bottom: 1rpx solid #f0f2f4;
}
.tool-item:last-child { border-bottom: 0; }
.tool-icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #f5f7f9;
}
.tool-icon image { width: 42rpx; height: 42rpx; }
.tool-icon-text { color: #c6000b; font-size: 28rpx; font-weight: 700; }
.tool-content { min-width: 0; flex: 1; padding: 0 20rpx; }
.tool-title, .tool-desc { display: block; }
.tool-title { color: #28323f; font-size: 27rpx; font-weight: 650; }
.tool-desc { margin-top: 5rpx; color: #7f8792; font-size: 24rpx; }
.tool-arrow { color: #adb3bb; font-size: 38rpx; font-weight: 300; }
.tool-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  margin-right: 12rpx;
  border-radius: 17rpx;
  color: #fff;
  background: #c6000b;
  font-size: 19rpx;
  line-height: 34rpx;
  text-align: center;
}

.flow-card { margin-top: 38rpx; padding: 26rpx 24rpx 30rpx; }
.flow-title { color: #303946; font-size: 27rpx; font-weight: 650; }
.flow-tip { color: #9ba2ab; font-size: 21rpx; }
.flow-steps { display: flex; align-items: flex-start; margin-top: 25rpx; }
.flow-step { display: flex; width: 112rpx; flex-direction: column; align-items: center; color: #68717d; font-size: 20rpx; white-space: nowrap; }
.step-no {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 9rpx;
  border-radius: 50%;
  color: #fff;
  background: #c6000b;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 42rpx;
  text-align: center;
}
.flow-line { height: 2rpx; flex: 1; margin: 21rpx -17rpx 0; background: #e5e8eb; }

.metric-card:active, .quick-item:active,
.warning-item:active, .tool-item:active {
  opacity: 0.72;
  transform: scale(0.985);
}
