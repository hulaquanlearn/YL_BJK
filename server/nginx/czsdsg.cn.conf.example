# 放在Nginx的http上下文中；证书路径由服务器实际环境替换。
limit_req_zone $binary_remote_addr zone=spare_login:10m rate=10r/m;

server {
    listen 80;
    server_name czsdsg.cn www.czsdsg.cn;
    return 301 https://czsdsg.cn$request_uri;
}

server {
    listen 443 ssl http2;
    server_name czsdsg.cn;
    server_tokens off;

    ssl_certificate     /实际证书路径/fullchain.pem;
    ssl_certificate_key /实际证书路径/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /api/auth/login {
        limit_req zone=spare_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000/api/auth/login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 130s;
        client_max_body_size 2m;
    }

    location / {
        proxy_pass http://127.0.0.1:8503;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
