NODE_ENV=production
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=spareparts
DB_PASSWORD=请填写服务器现有数据库密码
DB_NAME=spare_parts
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10

# 登录会话有效小时数。令牌由服务端随机生成，数据库只保存SHA-256哈希。
SESSION_HOURS=8

# 仅首次创建管理员时临时设置。创建完成后从.env删除密码并重启服务。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=请填写同时包含大写字母小写字母和数字的密码（不限制长度）


# 网页和小程序共用后端 DeepSeek Key；可显式 false 关闭生成、保留检索。
KNOWLEDGE_AI_ENABLED=true
KNOWLEDGE_AI_MODEL=deepseek-flash
# 私有调用记录及知识问答次数目录，升级保留，不配置为静态资源。
AI_AUDIT_DIR=/opt/spare-parts/data/ai-call-logs

# 原粮 AI 周总结（用户明确选择 DeepSeek 后启用，仅发送该本人周材料的文字与数量）
RAW_DUTY_AI_SUMMARY_ENABLED=false
DEEPSEEK_API_KEY=
# 仅用于管理员个人中心读取智谱普通 API 账户用量，未选择用于业务生成。
GLM_API_KEY=
# 只读查询混元个人套餐（hunyuan:DescribeTokenPlanUsage），不要使用模型调用 Key。
TENCENT_HY_USAGE_SECRET_ID=
TENCENT_HY_USAGE_SECRET_KEY=
# 或指定服务端私有 SecretId,SecretKey 两列 CSV，不放到静态目录/发布包。
# TENCENT_HY_USAGE_CREDENTIALS_FILE=/opt/spare-parts/private/hunyuan-usage.csv
# 仅个人本机开发可开启；生产默认关闭，云端可读取脱敏快照。
CODEX_USAGE_LOCAL_ENABLED=false
# CODEX_CLI_PATH=codex
# CODEX_USAGE_SNAPSHOT_FILE=/opt/spare-parts/data/codex-usage.json
RAW_DUTY_AI_MODEL=deepseek-flash


# Robot program assistant: calls DeepSeek directly, independent from OpenClaw.
ROBOT_AGENT_ENABLED=false
# 持久化备份与分析，不得作为Nginx静态目录；升级时保留并备份。
ROBOT_LIBRARY_DIR=/opt/spare-parts/data/robot-program-library
# Enable ROBOT_AGENT_ENABLED=true after setting the server-side DEEPSEEK_API_KEY.
ROBOT_AGENT_MODEL=deepseek-flash

# 工程知识库附件保存目录。生产环境应放在持久化磁盘，并由API进程拥有读写权限。
KNOWLEDGE_UPLOAD_DIR=/opt/spare-parts/uploads/fermentation-knowledge
# Private derived previews; never expose this directory through Nginx.
DOCUMENT_CACHE_DIR=/opt/spare-parts/cache/documents
DOCUMENT_TIMEOUT_MS=120000
DOCUMENT_CONCURRENCY=1
DOCUMENT_MAX_BYTES=524288000
LIBREOFFICE_BIN=soffice
PDFTOTEXT_BIN=pdftotext
TESSERACT_BIN=tesseract
DOCUMENT_OCR_LANG=chi_sim+eng
DOCUMENT_OCR_PAGES=5
PDFTOPPM_BIN=pdftoppm
KNOWLEDGE_MAX_FILE_SIZE=524288000
# 备件图片与类别模型必须使用持久化目录，不能放在每次替换的网页 dist 中。
PARTS_UPLOAD_DIR=/opt/spare-parts/uploads/part-images
PART_MODELS_UPLOAD_DIR=/opt/spare-parts/uploads/part-models
# 非标准静态目录才需要设置；关键词匹配检查此根目录下 models/ 中的文件。
# MODEL_ASSETS_DIR=/opt/spare-parts/web/dist
