NODE_ENV=production
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=spareparts
DB_PASSWORD=请填写服务器现有数据库密码
DB_NAME=spare_parts
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10

# 登录会话有效小时数。令牌由服务端随机生成，数据库只保存SHA-256哈希。
SESSION_HOURS=8

# 仅首次创建管理员时临时设置。创建完成后从.env删除密码并重启服务。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=请填写至少6位且同时包含大写字母小写字母和数字的密码

# OpenClaw 只允许 API 服务通过服务器本机访问。
# 默认禁止将问题、业务资料、库存、程序内容发送至模型网关，保留站内检索。
# 仅在核实网关使用离线模型且没有外部转发后，才可显式开启。
AI_CONTEXT_TRANSFER_ENABLED=false
OPENCLAW_API_URL=http://127.0.0.1:14504/v1/chat/completions
OPENCLAW_GATEWAY_TOKEN=请填写OpenClaw网关令牌
OPENCLAW_MODEL=openclaw/spare-parts-chat

# Windows TIA 解析节点专用令牌（至少32位随机字符，不与登录令牌共用）
PLC_AGENT_TOKEN=
OPENCLAW_TIMEOUT_MS=120000

# 制曲知识库附件保存目录。生产环境应放在持久化磁盘，并由API进程拥有读写权限。
KNOWLEDGE_UPLOAD_DIR=/opt/spare-parts/uploads/fermentation-knowledge
# Private derived previews; never expose this directory through Nginx.
DOCUMENT_CACHE_DIR=/opt/spare-parts/cache/documents
DOCUMENT_TIMEOUT_MS=120000
DOCUMENT_CONCURRENCY=1
DOCUMENT_MAX_BYTES=524288000
LIBREOFFICE_BIN=soffice
PDFTOTEXT_BIN=pdftotext
TESSERACT_BIN=tesseract
DOCUMENT_OCR_LANG=chi_sim+eng
DOCUMENT_OCR_PAGES=5
PDFTOPPM_BIN=pdftoppm
KNOWLEDGE_MAX_FILE_SIZE=524288000
# 备件图片与类别模型必须使用持久化目录，不能放在每次替换的网页 dist 中。
PARTS_UPLOAD_DIR=/opt/spare-parts/uploads/part-images
PART_MODELS_UPLOAD_DIR=/opt/spare-parts/uploads/part-models
# 非标准静态目录才需要设置；关键词匹配检查此根目录下 models/ 中的文件。
# MODEL_ASSETS_DIR=/opt/spare-parts/web/dist
# PLC 程序上传目录（生产环境建议放在 /opt/spare-parts/data 下并定期备份）
PLC_UPLOAD_DIR=/opt/spare-parts/data/plc-programs
PLC_MAX_FILE_SIZE=52428800
